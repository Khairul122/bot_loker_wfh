APP_ENV=development
# Supabase Postgres session-pooler URI (Dashboard > Connect). Keep it secret.
SUPABASE_DB_URL=
# Supabase cloud persistence (settings + character coordinates). Use the service-role
# key: RLS restricts app_settings/office_character_state to it. Keep it server-side only.
SUPABASE_URL=https://iujhspshmggmptoatbof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Set to true to let run-bot / run-scheduler call job APIs.
EXTERNAL_JOBS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to control the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Safe CV profile (copy resume/profile.example.json here and edit).
PROFILE_PATH=data/profile.json
FETCH_INTERVAL_HOURS=4

# 9Router settings. Legacy provider values are ignored.
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=LokerHouse
NINEROUTER_FALLBACK_MODELS=glm/glm-5.1,kr/claude-sonnet-4.5
LLM_MODEL_DRAFT=
LLM_MODEL_FORM=
LLM_MODEL_ANSWER=
LLM_TIMEOUT_SECONDS=60
LLM_TASK_BUDGET_SECONDS=90
LLM_TEMPERATURE_DRAFT=0.4

# Form filling engine & BrowserMCP configuration
FORM_ASSIST_ENABLED=false
FORM_ENGINE=browsermcp
BROWSER_MCP_COMMAND=npx -y @browsermcp/mcp@0.1.3
PLAYWRIGHT_MCP_COMMAND=npx -y @playwright/mcp@0.0.80 --extension --output-dir data/playwright-mcp
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
FORM_MIN_CONFIDENCE=0.7
FORM_MAX_ACTIONS=60
FORM_MAX_TOOL_CALLS=80
FORM_TIMEOUT_SECONDS=300
FORM_CONNECT_TIMEOUT_SECONDS=20
FORM_AI_ANSWERS=review
APPLICANT_PATH=data/applicant.json
ANSWERS_PATH=data/answers.json
LEAD_TELEGRAM_CHANNELS=
GITHUB_USERNAME=
