APP_ENV=development
DATABASE_URL=sqlite:///data/app.db
# Set to true to let run-bot / run-scheduler call job APIs.
EXTERNAL_JOBS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to control the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Safe CV profile (copy resume/profile.example.json here and edit).
PROFILE_PATH=data/profile.json
# Fetch cycle in hours (minimum 4).
FETCH_INTERVAL_HOURS=4

# LLM & Multi-model settings (9Router / Anthropic / Template)
# LLM_PROVIDER options: opencode | 9router | anthropic | template
# opencode = `opencode run` CLI (configure its 9router provider in ~/.config/opencode/opencode.json);
# falls back to 9Router directly when NINEROUTER_MODEL is set.
LLM_PROVIDER=template
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=loker-draft
NINEROUTER_FALLBACK_MODELS=glm/glm-5.1,kr/claude-sonnet-4.5
LLM_MODEL_DRAFT=
LLM_MODEL_FORM=
LLM_MODEL_ANSWER=
LLM_TIMEOUT_SECONDS=60
LLM_TASK_BUDGET_SECONDS=90
LLM_TEMPERATURE_DRAFT=0.4
OPENCODE_COMMAND=opencode
OPENCODE_MODEL=9router/ComboOpenCode

# Optional Anthropic direct API key (used if LLM_PROVIDER=anthropic or as fallback in 9Router)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Form filling engine & BrowserMCP configuration
FORM_ASSIST_ENABLED=false
# FORM_ENGINE options: browsermcp | playwright
FORM_ENGINE=browsermcp
BROWSER_MCP_COMMAND=npx -y @browsermcp/mcp@0.1.3
FORM_MIN_CONFIDENCE=0.7
FORM_MAX_ACTIONS=60
FORM_MAX_TOOL_CALLS=80
FORM_TIMEOUT_SECONDS=300
FORM_CONNECT_TIMEOUT_SECONDS=20
FORM_AI_ANSWERS=review
APPLICANT_PATH=data/applicant.json
ANSWERS_PATH=data/answers.json

# Optional: public Telegram channels to scan for freelance leads / source code deals (comma-separated usernames).
LEAD_TELEGRAM_CHANNELS=

# Public GitHub repos used as portfolio proof in freelance proposals (python -m bot_loker_wfh sync-github).
GITHUB_USERNAME=
